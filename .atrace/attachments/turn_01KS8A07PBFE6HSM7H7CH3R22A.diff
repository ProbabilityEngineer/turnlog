+fn attachments_markdown(attachments: &[Attachment]) -> String {
+    if attachments.is_empty() {
+        "- none\n".to_string()
+    } else {
+        attachments
+            .iter()
+            .map(|a| format!("- {:?}: `{}`\n", a.kind, a.path))
+            .collect()
+    }
