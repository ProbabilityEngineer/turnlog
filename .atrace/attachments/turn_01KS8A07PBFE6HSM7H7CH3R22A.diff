+pub fn diff(cwd: &Path) -> Option<String> {
+    if run(cwd, "jj", &["root"]).is_some() {
+        return run(cwd, "jj", &["diff", "--git"]);
+    }
+    if run(cwd, "git", &["rev-parse", "--show-toplevel"]).is_some() {
+        return run(cwd, "git", &["diff"]);
+    }
+    None
+}
